OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1
# Persistent local trial budget: at most 30 requests and $0.50 reserved spend.
AI_MAX_CALLS=30
AI_BUDGET_USD=0.50
PORT=8787
HOST=127.0.0.1
ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:8787,http://localhost:8787
# Exact HTTPS address from VS Code Ports. Leave empty for local-only testing.
PUBLIC_APP_URL=
